  "pieces": [
    {
      "id": "T1",
      "kind": "rewritten",
      "role": "meaning",
      "text": "次の文章を、意味を変えずに読みやすい日本語に書き直してください。",
      "sources": [
        "S01"
      ]
    },
    {
      "id": "T2",
      "kind": "rewritten",
      "role": "output",
      "text": "書き直した本文だけを返し、説明や前置きは付けないでください。",
      "sources": [
        "S13",
        "S03"
      ]
    },
    {
      "id": "T3",
      "kind": "rewritten",
      "role": "meaning",
      "text": "主張、比重、文の働き（事実、意見、依頼、問い、予定）、言い切りの強さ（推量、可能、許可、義務）、数値と数え方、固有名詞、日付、条件、否定は変えないでください。",
      "sources": [
        "S01",
        "S05"
      ]
    },
    {
      "id": "T4",
      "kind": "rewritten",
      "role": "meaning",
      "text": "原文にない情報、理由、主語、例は足さず、文も削らないでください。",
      "sources": [
        "S02",
        "S09"
      ]
    },
    {
      "id": "T5",
      "kind": "rewritten",
      "role": "meaning",
      "text": "分からない所は推測で埋めず、原文のまま残してください。",
      "sources": [
        "S03"
      ]
    },
    {
      "id": "T6",
      "kind": "rewritten",
      "role": "meaning",
      "text": "文体（です・ます、だ・である）、見出しや箇条書きの数と順、かぎかっこの中の言葉も保ってください。",
      "sources": [
        "S04",
        "S05"
      ]
    },
    {
      "id": "T7",
      "kind": "rewritten",
      "role": "style",
      "text": "物や概念を人のように動かす比喩、英語を一語ずつ写した言い回し、本文に出てこない比喩の見出し、「重要なのは」のような前置き、意味の増えない「AではなくB」、絵文字、ダッシュ、文末のコロン、間を作るだけの読点など、AIらしい言い回しはふつうの言葉に直してください。",
      "sources": [
        "S06",
        "S07",
        "S05",
        "S16",
        "S14",
        "S08",
        "S10",
        "S11"
      ]
    },
    {
      "id": "T10",
      "kind": "rewritten",
      "role": "style",
      "text": "文末の「と言えるでしょう」は、「〜に当たる」のような区分の判断でなければ「でしょう」にしてください。",
      "sources": [
        "S15"
      ]
    },
    {
      "id": "T8",
      "kind": "rewritten",
      "role": "meaning",
      "text": "ただし、「仕様変更が」を「仕様が変わると」にするような、つながりを変える書き換えはしないでください。",
      "sources": [
        "S09",
        "S01"
      ]
    },
    {
      "id": "T9",
      "kind": "rewritten",
      "role": "restraint",
      "text": "自然な文と慣用句も直さないでください。",
      "sources": [
        "S07",
        "S12"
      ]
    }
  ]
}
